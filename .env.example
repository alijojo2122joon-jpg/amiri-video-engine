# Amiri Video Engine does NOT read API keys from files or from the source code.
# Keys are typed into the app (Settings -> AI Providers) and stored encrypted
# with the Android Keystore on the phone. This file only documents which keys exist.
#
# Free (recommended): Hugging Face access token, read-only is enough.
#   Get it at https://huggingface.co/settings/tokens
HF_TOKEN=
#
# Optional paid providers (leave empty if you don't use them):
GOOGLE_GEMINI_API_KEY=
XAI_API_KEY=
